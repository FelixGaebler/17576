{
  "name": "prisma-compute-nextjs",
  "private": true,
  "license": "AGPL-3.0-only",
  "author": "Felix Gaebler <felix@gaebler.dev>",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "next dev",
    "build": "bun run contract:emit && next build",
    "start": "node .next/standalone/server.js",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "bun test",
    "contract:emit": "prisma contract emit",
    "migration:plan": "prisma migration plan",
    "db:init": "prisma db init",
    "db:update": "prisma db update",
    "db:migrate": "prisma db migrate",
    "db:seed": "tsx src/prisma/seed.ts",
    "compute:login": "prisma auth login",
    "compute:database:create": "prisma postgres create prisma-compute-nextjs --branch main",
    "compute:connect": "prisma git connect",
    "compute:open": "prisma service open"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@prisma/composer": "0.16.0",
    "@prisma/composer-prisma-cloud": "0.16.0",
    "@prisma/orm-postgres": "8.0.0-rc.8",
    "@tailwindcss/postcss": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "dotenv": "17.4.2",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.49.0",
    "next": "16.2.7",
    "postcss": "^8.5.28",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "^4.21.1",
    "tailwindcss": "^4.3.3",
    "temporal-polyfill": "^1.0.5",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@prisma/cli-engine": "0.3.0",
    "@types/bun": "^1.4.2",
    "@types/node": "24.12.4",
    "@types/react": "19.2.16",
    "@types/react-dom": "19.2.3",
    "alchemy": "2.0.0-beta.74",
    "eslint": "9",
    "eslint-config-next": "16.2.7",
    "prisma": "8.0.0-rc.12",
    "tsx": "4.22.4",
    "typescript": "5.9.3"
  },
  "allowScripts": {
    "esbuild": true,
    "msgpackr-extract": true,
    "workerd": true
  }
}