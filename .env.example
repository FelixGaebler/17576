DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require"

# Sign-in via OpenID Connect. Leave OIDC_ISSUER empty to use the development user.
OIDC_ISSUER=""
OIDC_CLIENT_ID=""
OIDC_CLIENT_SECRET=""
# OIDC_SCOPES="openid profile email"
# Members of this group (from the `groups` claim) can invalidate meanings.
# OIDC_ADMIN_GROUP="twentysix_admin"
APP_URL="http://localhost:3000"
# At least 32 random characters, e.g. `openssl rand -base64 32`
SESSION_SECRET=""

