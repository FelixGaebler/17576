// use prisma-next

enum ScoreTransactionType {
  @@type("pg/text@1")
  NEW_ACRONYM     = "NEW_ACRONYM"
  EXISTING_ENTRY  = "EXISTING_ENTRY"
  DUPLICATE_FOUND = "DUPLICATE_FOUND"
  // Takes back the points of a meaning an admin deleted.
  INVALIDATED_MEANING = "INVALIDATED_MEANING"
}

model User {
  id          Uuid     @id @default(uuid(7))
  // Identifier from the identity provider (Keycloak, later).
  externalId  String   @unique
  displayName String
  email       String   @unique
  avatarUrl   String?
  // Cached sum of the user's ScoreTransaction amounts.
  score       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   temporal.updatedAt()
}

model Acronym {
  id              Uuid      @id @default(uuid(7))
  code            String    @unique
  createdByUserId Uuid
  createdBy       User      @relation(fields: [createdByUserId], references: [id])
  meanings        Meaning[]
  createdAt       DateTime  @default(now())
  updatedAt       temporal.updatedAt()

  @@check(expression: "code ~ '^[A-Z]{3}$'", name: "acronym_code_format")
}

model Meaning {
  id              Uuid     @id @default(uuid(7))
  acronymId       Uuid
  acronym         Acronym  @relation(fields: [acronymId], references: [id])
  text            String
  normalizedText  String
  createdByUserId Uuid
  createdBy       User     @relation(fields: [createdByUserId], references: [id])
  createdAt       DateTime @default(now())
  updatedAt       temporal.updatedAt()

  @@unique([acronymId, normalizedText])
}

model ScoreTransaction {
  id          Uuid                 @id @default(uuid(7))
  userId      Uuid
  user        User                 @relation(fields: [userId], references: [id])
  // Null once the meaning was invalidated and deleted.
  acronymId   Uuid?
  acronym     Acronym?             @relation(fields: [acronymId], references: [id])
  meaningId   Uuid?
  meaning     Meaning?             @relation(fields: [meaningId], references: [id])
  // Snapshot of the deleted meaning; set only after an invalidation.
  acronymCode String?
  meaningText String?
  amount      Int
  type        ScoreTransactionType
  createdAt   DateTime             @default(now())

  // A user can score each meaning only once.
  @@unique([userId, meaningId])
}
